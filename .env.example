# Copy to .env.local for local development. NEVER commit real secrets (Brief 01: no-secret rule).
# All values below are safe placeholders. Real provider credentials are BLOCKED pending decisions
# recorded in DECISIONS.md.

# Public site URL (used for canonical URLs, sitemap, robots). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment environment: "development" | "staging" | "production".
# Staging must be no-indexed (Brief 06).
NEXT_PUBLIC_APP_ENV=development

# Lead delivery mode (Brief 05).
#   test = submissions are validated and logged server-side but NO email is sent (safe default).
#   live = submissions are emailed to the support inbox via SMTP (requires SMTP_* below).
LEAD_DELIVERY_MODE=test

# --- Lead email delivery (used when LEAD_DELIVERY_MODE=live) ---
# Where enquiries are sent (defaults to support@vigercloud.com if unset).
# LEAD_NOTIFICATION_EMAIL=support@vigercloud.com
# From/sender address (defaults to SMTP_USER). Should be an address your SMTP provider allows.
# LEAD_FROM_EMAIL=no-reply@vigercloud.com
# SMTP connection. For Hostinger email use host smtp.hostinger.com, port 465 (secure) with the
# support@vigercloud.com mailbox credentials. Any SMTP provider (Resend/SendGrid/etc.) also works.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@vigercloud.com
# SMTP_PASS=your_mailbox_or_provider_password

# --- Sanity CMS (Brief 07). Optional: without a real project id the site uses built-in fallback
#     content and /studio shows a setup notice. ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Read token (server-only; never expose). REQUIRED at runtime if the Sanity dataset is private
# (Sanity's default). If the dataset is public, this is optional.
# SANITY_API_READ_TOKEN=
# Write token (server-only) — only needed to run scripts/seed-sanity.mjs to (re)initialise content.
# SANITY_API_WRITE_TOKEN=

# --- Placeholders for later integration (currently unused) ---
# CRM_API_KEY=
# ANALYTICS_WRITE_KEY=
