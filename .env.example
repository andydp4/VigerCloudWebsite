# Copy to .env.local for local development. NEVER commit real secrets (Brief 01: no-secret rule).
# All values below are safe placeholders. Real provider credentials are BLOCKED pending decisions
# recorded in DECISIONS.md.

# Public site URL (used for canonical URLs, sitemap, robots). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment environment: "development" | "staging" | "production".
# Staging must be no-indexed (Brief 06).
NEXT_PUBLIC_APP_ENV=development

# Lead delivery mode. Keep "test" until the Staging Gate approval (Brief 05).
# In "test" mode, submissions are validated and logged server-side but NOT sent to any provider.
LEAD_DELIVERY_MODE=test

# --- Sanity CMS (Brief 07). Optional: without a real project id the site uses built-in fallback
#     content and /studio shows a setup notice. ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Read token (server-only; never expose). REQUIRED at runtime if the Sanity dataset is private
# (Sanity's default). If the dataset is public, this is optional.
# SANITY_API_READ_TOKEN=
# Write token (server-only) — only needed to run scripts/seed-sanity.mjs to (re)initialise content.
# SANITY_API_WRITE_TOKEN=

# --- Placeholders for later integration (currently unused / test mode only) ---
# CRM_API_KEY=
# EMAIL_API_KEY=
# EMAIL_FROM=
# ANALYTICS_WRITE_KEY=
